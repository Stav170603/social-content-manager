<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.otzar.sscm.entities.User" table="users">
        <id name="user_id" column="user_id" type="long">
            <generator class="identity"/>
        </id>
        <property name="full_name" column="full_name" type="string" not-null="true"/>
        <property name="email" column="email" type="string"/>
        <property name="username" column="username" type="string" not-null="true"/>
        <property name="password" column="password" type="string" not-null="true"/>
        <property name="role" column="role" type="string" not-null="true"/>
        <property name="token" column="token" type="string"/>
    </class>

    <class name="com.otzar.sscm.entities.Client" table="clients">
        <id name="client_id" column="client_id" type="long">
            <generator class="identity"/>
        </id>
        <property name="user_id" column="user_id" type="long" not-null="true"/>
        <property name="admin_id" column="admin_id" type="long"/>
        <property name="business_name" column="business_name" type="string" not-null="true"/>
        <property name="phone" column="phone" type="string"/>
        <property name="instagramUsername" column="instagram_username" type="string"/>
        <property name="archived" column="archived" type="boolean" not-null="true"/>
    </class>

    <class name="com.otzar.sscm.entities.Content" table="contents">
        <id name="content_id" column="content_id" type="long">
            <generator class="identity"/>
        </id>
        <property name="clientId" column="client_id" type="long" not-null="true"/>
        <property name="title" column="title" type="string" not-null="true"/>
        <property name="description" column="description" type="text"/>
        <property name="file_url" column="file_url" type="string"/>
        <property name="content_type" column="content_type" type="string"/>
        <property name="plannedPublishDate" column="planned_publish_date" type="java.time.LocalDateTime"/>
        <property name="createdAt" column="created_at" type="java.time.LocalDateTime" insert="false" update="false"/>
        <property name="feedOrder" column="feed_order" type="integer"/>
        <property name="status" column="status" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">com.otzar.sscm.entities.ContentStatus</param>
                <param name="useNamed">true</param>
            </type>
        </property>
    </class>

    <class name="com.otzar.sscm.entities.ContentVersion" table="content_versions" mutable="false">
        <id name="contentVersionId" column="content_version_id" type="long">
            <generator class="identity"/>
        </id>
        <property name="contentId" column="content_id" type="long" not-null="true" unique-key="uk_content_version_number"/>
        <property name="versionNumber" column="version_number" type="integer" not-null="true" unique-key="uk_content_version_number"/>
        <property name="title" column="title" type="string" not-null="true"/>
        <property name="description" column="description" type="text"/>
        <property name="contentType" column="content_type" type="string" not-null="true"/>
        <property name="fileUrl" column="file_url" type="string"/>
        <property name="status" column="status" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">com.otzar.sscm.entities.ContentStatus</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="plannedPublishDate" column="planned_publish_date" type="java.time.LocalDateTime"/>
        <property name="changedByUserId" column="changed_by_user_id" type="long"/>
        <property name="changedAt" column="changed_at" type="java.time.LocalDateTime" not-null="true"/>
        <property name="changeType" column="change_type" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">com.otzar.sscm.entities.ContentVersionChangeType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
    </class>
    <class name="com.otzar.sscm.entities.ContentMedia" table="content_media">
        <id name="mediaId" column="media_id" type="long"><generator class="identity"/></id>
        <property name="contentId" column="content_id" type="long" not-null="true" unique-key="uk_content_media_order"/>
        <property name="mediaUrl" column="media_url" type="string" not-null="true"/>
        <property name="mediaType" column="media_type" type="string" not-null="true"/>
        <property name="displayOrder" column="display_order" type="integer" not-null="true" unique-key="uk_content_media_order"/>
        <property name="thumbnailUrl" column="thumbnail_url" type="string"/>
        <property name="createdAt" column="created_at" type="java.time.LocalDateTime" insert="false" update="false"/>
    </class>
    <class name="com.otzar.sscm.entities.ContentVersionMedia" table="content_version_media" mutable="false">
        <id name="versionMediaId" column="version_media_id" type="long"><generator class="identity"/></id>
        <property name="contentVersionId" column="content_version_id" type="long" not-null="true" unique-key="uk_version_media_order"/>
        <property name="mediaUrl" column="media_url" type="string" not-null="true"/>
        <property name="mediaType" column="media_type" type="string" not-null="true"/>
        <property name="displayOrder" column="display_order" type="integer" not-null="true" unique-key="uk_version_media_order"/>
        <property name="thumbnailUrl" column="thumbnail_url" type="string"/>
    </class>

    <class name="com.otzar.sscm.entities.Comment" table="comments">
        <id name="commentId" column="comment_id" type="long">
            <generator class="identity"/>
        </id>
        <property name="contentId" column="content_id" type="long"/>
        <property name="userId" column="user_id" type="long"/>
        <property name="commentText" column="commentText" type="text"/>
        <property name="createdAt" column="created_at" type="java.time.LocalDateTime" insert="false" update="false"/>
    </class>

    <class name="com.otzar.sscm.entities.Admin" table="admins">
        <id name="adminId" column="admin_id" type="long"><generator class="identity"/></id>
        <property name="userId" column="user_id" type="long" not-null="true"/>
    </class>

    <class name="com.otzar.sscm.entities.InstagramConnectionSettings" table="instagram_connection_settings">
        <id name="settingsId" column="settings_id" type="long">
            <generator class="identity"/>
        </id>
        <property name="clientId" column="client_id" type="long" not-null="true" unique="true"/>
        <property name="instagramUserId" column="instagram_user_id" type="string" not-null="true"/>
        <property name="graphApiBaseUrl" column="graph_api_base_url" type="string" not-null="true"/>
        <property name="updatedAt" column="updated_at" type="java.time.LocalDateTime" not-null="true"/>
    </class>

    <class name="com.otzar.sscm.entities.Notification" table="notifications">
        <id name="notificationId" column="notification_id" type="long"><generator class="identity"/></id>
        <property name="userId" column="user_id" type="long" not-null="true"/>
        <property name="type" column="type" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">com.otzar.sscm.entities.NotificationType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="title" column="title" type="string" not-null="true"/>
        <property name="message" column="message" type="text" not-null="true"/>
          <property name="relatedContentId" column="related_content_id" type="long"/>
        <property name="read" column="is_read" type="boolean" not-null="true"/>
        <property name="createdAt" column="created_at" type="java.time.LocalDateTime" not-null="true"/>
    </class>

    <class name="com.otzar.sscm.entities.PublicationRecord" table="publication_records">
        <id name="publicationId" column="publication_id" type="long"><generator class="identity"/></id>
        <property name="deliveryKey" column="delivery_key" type="string" not-null="true" unique="true"/>
        <property name="contentId" column="content_id" type="long" not-null="true"/>
        <property name="provider" column="provider" not-null="true">
            <type name="org.hibernate.type.EnumType"><param name="enumClass">com.otzar.sscm.models.PublishingProviderType</param><param name="useNamed">true</param></type>
        </property>
        <property name="targetPlatform" column="target_platform" type="string"/>
        <property name="status" column="status" not-null="true">
            <type name="org.hibernate.type.EnumType"><param name="enumClass">com.otzar.sscm.entities.PublicationStatus</param><param name="useNamed">true</param></type>
        </property>
        <property name="requestedAt" column="requested_at" type="java.time.LocalDateTime" not-null="true"/>
        <property name="startedAt" column="started_at" type="java.time.LocalDateTime"/>
        <property name="publishedAt" column="published_at" type="java.time.LocalDateTime"/>
        <property name="externalPostId" column="external_post_id" type="string"/>
        <property name="errorCode" column="error_code" type="string"/>
        <property name="errorMessage" column="error_message" type="string"/>
        <property name="attemptNumber" column="attempt_number" type="integer" not-null="true"/>
        <property name="triggerType" column="trigger_type" not-null="true">
            <type name="org.hibernate.type.EnumType"><param name="enumClass">com.otzar.sscm.entities.PublicationTriggerType</param><param name="useNamed">true</param></type>
        </property>
        <property name="requestedByUserId" column="requested_by_user_id" type="long"/>
        <property name="createdAt" column="created_at" type="java.time.LocalDateTime" not-null="true"/>
        <property name="updatedAt" column="updated_at" type="java.time.LocalDateTime" not-null="true"/>
    </class>
</hibernate-mapping>
